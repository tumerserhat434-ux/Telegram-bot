# Yerelde çalıştırırken bu dosyayı ".env" adıyla kopyalayın.
# Railway'de bu değerleri Variables sekmesine girin. .env GitHub'a GÖNDERİLMEZ.

# @BotFather'dan aldığınız token
BOT_TOKEN=123456789:BURAYA_TOKENINIZI_YAZIN

# Sizin Telegram kullanıcı ID'niz (@userinfobot'tan öğrenin). Yönetim sadece bu hesaba açılır.
ADMIN_ID=123456789

# Veritabanı ve fotoğrafların duracağı yer. Railway'de Volume'u /data'ya bağlayıp bunu kullanın.
DB_PATH=/data/bot.db

# Mini uygulama adresi. Railway'de "Generate Domain" yaptıysanız boş bırakın, otomatik bulunur.
# WEBAPP_URL=https://ornek.up.railway.app/
