# BotFather'dan aldığın token
BOT_TOKEN=123456:ABC-DEF...
# Oyunun açılacağı https adresi (ör. Cloudflare Tunnel adresi)
WEBAPP_URL=https://ornek.trycloudflare.com
PORT=8080
# Admin komutları (/havuz, /cekimler, /odendi, /reddet) için Telegram kullanıcı ID'n (birden fazlaysa virgülle)
ADMIN_IDS=123456789
# Reklam gelirinin oyunculara dağıtılan oranı (0.5 = %50)
POOL_PCT=0.5
# Kişi başı günlük puanlı döner sınırı, sipariş başına en az süre (sn), en düşük çekim ($)
DAILY_CAP=400
MIN_SERVE_SECONDS=4
MIN_WITHDRAW_USD=2
# Kaç puan = 1 yıldız, 1 yıldızın dolar karşılığı (ödeme hesabı için)
POINTS_PER_STAR=12
STAR_USD=0.013
